# Copy to .env and fill in. .env is gitignored.

# Bot token from https://discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_BOT_TOKEN=

# Snowflake ID of the guild (server) to ingest. Right-click the server name in Discord
# (with Developer Mode enabled) → Copy Server ID.
DISCORD_GUILD_ID=

# Optional: only backfill messages newer than this UTC instant on the first sync.
# Leave blank to fetch from the beginning of each channel.
# Example: 2026-01-01T00:00:00Z
DISCORD_BACKFILL_SINCE_UTC=
