{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Information",
      "System.Net.Http": "Information",
      "Polly": "Information"
    }
  },
  "Postgres": {
    "ConnectionString": "Host=localhost;Port=5432;Database=discord_scraper;Username=discord;Password=discord"
  },
  "Mongo": {
    "ConnectionString": "mongodb://discord:discord@localhost:27017/?directConnection=true&replicaSet=rs0",
    "DatabaseName": "discord_scraper"
  },
  "RabbitMq": {
    "Host": "amqp://localhost",
    "Username": "discord",
    "Password": "discord"
  },
  "Discord": {},
  "ReadBatch": {
    "Messages": { "BatchTimeout": "00:00:10", "BatchMessageLimit": 2000 },
    "Channels": { "BatchTimeout": "00:00:02", "BatchMessageLimit": 50 },
    "Guilds":   { "BatchTimeout": "00:00:02", "BatchMessageLimit": 10 }
  },
  "Ollama": {
    "Tag": {
      "BaseUrl": "http://localhost:11434",
      "Model": "nomic-embed-text",
      "VectorSize": 768
    },
    "Classify": {
      "BaseUrl": "http://localhost:11434",
      "Model": "llama3.1:8b"
    }
  },
  "Enrichment": {
    "Tag": {
      "ConcurrentMessageLimit": 8,
      "PrefetchCount": 8,
      "HttpTimeout": "00:00:15",
      "RetryAttempts": 2,
      "RetryMinInterval": "00:00:00.500",
      "RetryMaxInterval": "00:00:02",
      "RetryIntervalDelta": "00:00:00.500",
      "RequestTimeout": "00:00:30",
      "KillSwitchActivationThreshold": 10,
      "KillSwitchTripThreshold": 20,
      "KillSwitchTrackingPeriod": "00:01:00",
      "KillSwitchRestartTimeout": "00:00:30"
    },
    "Classify": {
      "ConcurrentMessageLimit": 1,
      "PrefetchCount": 1,
      "HttpTimeout": "00:01:30",
      "RequestTimeout": "00:03:00",
      "KillSwitchActivationThreshold": 5,
      "KillSwitchTripThreshold": 20,
      "KillSwitchTrackingPeriod": "00:02:00",
      "KillSwitchRestartTimeout": "00:01:00"
    },
    "Version": 1,
    "BatchSize": 50,
    "PollInterval": "00:00:30",
    "MaxTaggingContentChars": 2000
  },
  "Qdrant": {
    "BaseUrl": "http://localhost:6333",
    "CollectionName": "discord-messages"
  }
}
